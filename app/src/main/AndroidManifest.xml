<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vortex.engine.studio"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- OpenGL ES 2.0+ hardware acceleration for 2D & 3D Game Engine -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- Termux RUN_COMMAND IPC permission -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Shared storage export for Termux project folders -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Install Termux-compiled standalone Game APKs directly from Studio -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+ package visibility for Termux &RunCommandService -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.api" />
        <intent>
            <action android:name="com.termux.RUN_COMMAND" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/VortexTheme">

        <!-- Project Hub & Termux Toolchain Manager -->
        <activity
            android:name="com.vortex.engine.studio.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full 2D/3D Scene Editor, Entity Inspector, VortexScript IDE, Play Mode & APK Compiler -->
        <activity
            android:name="com.vortex.engine.studio.EditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Standalone Runtime Preview Activity (also packaged as main launcher in exported APKs) -->
        <activity
            android:name="com.vortex.engine.runtime.StandaloneGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <!-- Receives stdout, stderr, and exitCode from Termux RUN_COMMAND PendingIntent -->
        <service
            android:name="com.vortex.engine.studio.TermuxResultService"
            android:exported="true" />

        <!-- Zero-dependency ContentProvider to share compiled APKs with Android Package Installer -->
        <provider
            android:name="com.vortex.engine.studio.VortexFileProvider"
            android:authorities="com.vortex.engine.studio.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
