<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vortex.engine.studio"
    android:versionCode="14"
    android:versionName="4.6.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- Optional BYOK Cloud Models in Vortex Forge AI (offline generator needs zero internet) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Termux Direct Build Integration -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Shared storage export for Termux & APK install trigger -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility for com.termux -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="com.vortex.engine.studio.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.vortex.engine.studio.EditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name="com.vortex.engine.runtime.StandaloneGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:exported="false" />

        <service
            android:name="com.vortex.engine.studio.TermuxResultService"
            android:exported="false" />

        <provider
            android:name="com.vortex.engine.studio.VortexFileProvider"
            android:authorities="com.vortex.engine.studio.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
